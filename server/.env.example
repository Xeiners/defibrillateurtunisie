# Adresse Gmail qui ENVOIE les messages.
SMTP_USER=contact@votredomaine.tn

# Mot de passe d'APPLICATION Google, pas le mot de passe du compte.
# Il s'obtient sur https://myaccount.google.com/apppasswords
# (la validation en deux etapes doit etre active sur le compte).
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Adresse qui RECOIT les demandes. Par defaut, celle qui envoie.
MAIL_TO=contact@votredomaine.tn

# Nom affiche comme expediteur.
MAIL_FROM_NAME=Defibrillateur.TN

# Port d'ecoute du service. Le serveur web relaie /api/devis vers lui.
PORT=8787

# A ne remplir qu'en developpement, quand le front tourne sur un autre port.
# En production, front et service partagent le domaine : laisser vide.
# ALLOWED_ORIGIN=http://localhost:5173
